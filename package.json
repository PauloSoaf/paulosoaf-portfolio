{
  "name": "paulo-soaf-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portfólio Paulo Soaf — design Obsidian Orbit (Next.js App Router).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 1010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:screenshots": "playwright test --config playwright.visual.config.ts",
    "qa:hero": "playwright test --config playwright.hero-visual.config.ts",
    "qa:hero:summary": "node scripts/summarize-hero-qa.mjs",
    "release:check": "vitest run --config vitest.release.config.mts",
    "art:light": "node scripts/derive-light-orb.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
